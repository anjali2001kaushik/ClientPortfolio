# Copy this file to ".env" in the same folder (server/.env) and fill in
# real values. ".env" is gitignored on purpose since it holds secrets.

# Port the Express API (and, in production, the built React app) runs on.
PORT=4000

# Which origin is allowed to call the API in development (the Vite dev
# server). Only matters locally.
CLIENT_ORIGIN=http://localhost:5173

# --- Contact form email (required for the "Let's Talk" modal to send mail) ---
# Using Gmail SMTP as an example — works with any SMTP provider.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=youraddress@gmail.com
# Gmail requires an App Password, NOT your normal Gmail password.
# Generate one at https://myaccount.google.com/apppasswords
# (needs 2-Step Verification turned on first). It's a 16-character code.
SMTP_PASS=your-16-character-app-password

# Who receives the "new contact" notification email. Defaults to SMTP_USER
# if left blank.
CONTACT_RECEIVER=youraddress@gmail.com
